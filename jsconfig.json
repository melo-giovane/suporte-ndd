{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "scripts/**/*.js",
    "server/**/*.js"
  ],
  "exclude": ["node_modules", "dist", "build", "data"]
}
