{
  "name": "relatorios-central",
  "private": true,
  "version": "2.0.0",
  "author": "Giovane Melo",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node server/api.js",
    "dev:full": "npm run dev",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:init": "node scripts/db/init-db.js",
    "db:import": "node scripts/db/import-dashboard.js",
    "db:update-daily": "node scripts/db/update-daily.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "^5.7.3",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
