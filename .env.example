# Porta e host do servidor Express
API_PORT=8787
API_HOST=0.0.0.0

# Sincronização automática ao login do master
# Defina MASTER_AUTO_SYNC_ENABLED=true e aponte para o arquivo consolidado
# Se MASTER_AUTO_SYNC_FILE não for definido, a sincronização fica desativada automaticamente
MASTER_AUTO_SYNC_ENABLED=false
MASTER_AUTO_SYNC_FILE=/caminho/para/Dashboard_Central.xlsx
MASTER_AUTO_SYNC_YEAR=2026

# Credenciais do usuário master criado na primeira inicialização do banco
# Altere antes de rodar npm run db:init em produção
DEFAULT_MASTER_USER=master
DEFAULT_MASTER_PASSWORD=master123

# Meta padrão de registros (%) usada quando o banco ainda não tem configuração salva
TICKET_GOAL_PCT=20
